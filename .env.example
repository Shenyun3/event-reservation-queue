# PostgreSQL 开发数据库与独立集成测试数据库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/queue_reservation?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/queue_reservation_test?schema=public"

# PostgreSQL 连接池上限（压测并发上限 <= DB_POOL_MAX - 5）
DB_POOL_MAX="30"

# 后端监听端口与 10 秒超时巡检 Worker 开关
PORT="3000"
ENABLE_EXPIRATION_WORKER="true"
LOG_LEVEL="info"
